<Window x:Class="ArcZipWindows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ArcZip Windows" Height="760" Width="1180" MinHeight="540" MinWidth="860"
 Background="#F4F6FA" WindowStartupLocation="CenterScreen" AllowDrop="True"
 DragOver="Window_DragOver" Drop="Window_Drop">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#315EFB"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E9EDF5"/>
   <Setter Property="Foreground" Value="#1F2937"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E5EAF2"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" Padding="20,18" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="API: Start" Click="Api_Click" x:Name="ApiButton" Background="#E0EAFE" Foreground="#1D4ED8"/>
     <Button Content="Create ZIP" Click="Create_Click" Background="#315EFB" Foreground="White"/>
     <Button Content="Open archive" Click="Open_Click" Background="#172033" Foreground="White"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="ArcZip Windows" FontSize="25" FontWeight="SemiBold" Foreground="#111827"/>
     <TextBlock x:Name="ArchiveLabel" Text="A lightweight workspace for your archives" Foreground="#64748B" Margin="0,5,0,0" FontSize="13"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Top" Background="White" Padding="12,10" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
     <Button x:Name="AddButton" Content="Add files" Click="Add_Click"/>
     <Button Content="Extract selected" Click="Extract_Click"/><Button Content="Extract all" Click="ExtractAll_Click"/><Button Content="Verify archive" Click="Verify_Click"/><Button x:Name="EditExternallyButton" Content="Edit externally" Click="EditExternally_Click"/><Button x:Name="SaveBackButton" Content="Save back to ZIP" Click="SaveBack_Click" IsEnabled="False" Background="#DDF7E8" Foreground="#166534"/>
     <Button x:Name="RenameButton" Content="Rename" Click="Rename_Click"/>
     <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Background="#FDECEC" Foreground="#B42318"/>
    </StackPanel>
    <Border Background="#F3F5F9" CornerRadius="8" Margin="8,3,3,3" Padding="9,0" HorizontalAlignment="Right">
     <DockPanel>
      <TextBlock Text="⌕" FontSize="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="SearchBox" Width="230" Height="34" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" ToolTip="Search archive entries" TextChanged="Search_TextChanged"/>
     </DockPanel>
    </Border>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" Padding="14,7">
   <DockPanel><TextBlock x:Name="StatusText" Text="Ready" Foreground="#64748B" VerticalAlignment="Center"/><TextBlock Text="Multi-format archive workspace · API is opt-in" Foreground="#94A3B8" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <Border Margin="16" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="12" Padding="4">
   <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" RowHeight="42" HeadersVisibility="Column">
    <DataGrid.Columns>
     <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="280"/>
     <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="100"/>
     <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="130"/>
     <DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedText}" Width="180"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </DockPanel>
</Window>