<Window x:Class="ArcZipWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ArcZip Windows" Height="720" Width="1120" MinHeight="520" MinWidth="820" Background="#F5F7FB" WindowStartupLocation="CenterScreen"><DockPanel><Border DockPanel.Dock="Top" Background="White" Padding="16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open archive…" Click="Open_Click"/><Button Content="Create ZIP…" Click="Create_Click"/></StackPanel><StackPanel><TextBlock Text="ArcZip Windows" FontSize="24" FontWeight="SemiBold" Foreground="#111827"/><TextBlock x:Name="ArchiveLabel" Text="Open a ZIP archive to get started" Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel></DockPanel></Border><Border DockPanel.Dock="Top" Background="White" Padding="10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Add files" Click="Add_Click"/><Button Content="Extract selected" Click="Extract_Click"/><Button Content="Rename" Click="Rename_Click"/><Button Content="Delete" Click="Delete_Click"/></StackPanel><TextBox x:Name="SearchBox" Width="260" Height="32" VerticalContentAlignment="Center" Margin="8,3,3,3" ToolTip="Search archive entries" TextChanged="Search_TextChanged"/></DockPanel></Border><StatusBar DockPanel.Dock="Bottom" Background="White"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem></StatusBar><DataGrid x:Name="EntriesGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" Background="White" BorderBrush="#E5E7EB" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="130"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="180"/></DataGrid.Columns></DataGrid></DockPanel></Window>